# Clave del integrador. Los planes públicos funcionan sin ella.
VERIKO_API_KEY=

# Opcional: URL base alternativa para desarrollo o pruebas.
# VERIKO_BASE_URL=https://api.veriko.mx/v1

# core, all o una lista de familias separadas por coma.
VERIKO_MCP_PROFILE=core

# read, write o destructive. Por omisión permite write y oculta destructive.
VERIKO_MCP_MAX_RISK=write
